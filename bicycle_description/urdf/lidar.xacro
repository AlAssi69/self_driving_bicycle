<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      2D lidar on a mast. The sensor publishes sensor_msgs/LaserScan on /scan
      (bridged from Gazebo) in frame laser_frame.
      parent:  link the mast stands on
      mount_z: height of the scan plane above the parent link origin [m]
      config:  the `lidar` block of config/geometry.yaml
    -->
    <xacro:macro name="lidar" params="parent mount_z config">
        <xacro:property name="mast_length" value="${mount_z - config.length/2}" />

        <joint name="laser_joint" type="fixed">
            <parent link="${parent}" />
            <child link="laser_frame" />
            <origin xyz="0 0 ${mount_z}" rpy="0 0 0" />
        </joint>

        <link name="laser_frame">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${config.length}" radius="${config.radius}" />
                </geometry>
                <material name="black" />
            </visual>
            <visual>
                <origin xyz="0 0 ${-(mount_z + config.length/2)/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${mast_length}" radius="${config.mast_radius}" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${config.length}" radius="${config.radius}" />
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${config.mass}" length="${config.length}"
                radius="${config.radius}">
                <origin xyz="0 0 0" rpy="0 0 0" />
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="laser_frame">
            <sensor name="lidar" type="gpu_lidar">
                <topic>scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>${config.update_rate}</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${config.samples}</samples>
                            <resolution>1</resolution>
                            <!-- Full circle without a duplicated first/last beam. -->
                            <min_angle>${-pi}</min_angle>
                            <max_angle>${pi - 2*pi/config.samples}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${config.min_range}</min>
                        <max>${config.max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>
