<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      Wheel link spinning about its y axis. The joint is declared by the caller so the
      kinematic tree stays readable in one place.
      config: the `wheel` block of config/geometry.yaml (radius, width, mass, friction).
    -->
    <xacro:macro name="wheel_link" params="name config">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder length="${config.width}" radius="${config.radius}" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder length="${config.width}" radius="${config.radius}" />
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${config.mass}" length="${config.width}"
                radius="${config.radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${name}">
            <mu1>${config.friction}</mu1>
            <mu2>${config.friction}</mu2>
        </gazebo>
    </xacro:macro>

</robot>
