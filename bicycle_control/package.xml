<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bicycle_control</name>
  <version>2.0.0</version>
  <description>
    ros2_control controllers (bicycle steering controller, joint state broadcaster) and the
    velocity command multiplexer of the self-driving bicycle. Independent of the simulator.
  </description>
  <maintainer email="smart.teen.12345@gmail.com">Ashraf AlAssi</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/AlAssi69/self_driving_bicycle</url>
  <author>Ashraf AlAssi</author>
  <author>Mhd. Osama Keakaty</author>
  <author>Sarah AlAhmad</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bicycle_steering_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
